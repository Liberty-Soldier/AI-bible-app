d see קרע ). Specifically of priest's tunic Exod 28:4 , 39 (embroidered, see תַּשְׁבֵּץ שׁבץ, ), 28:40 ; 29:5 , 8 ; 39:27 (made of שֵׁשׁ , q. v.), 40:14 ; Lev 8:7 , 13 ; 10:5 ; קֹדֶשׁ׳כּ בַּֿד 16:4 a holy linen tunic , of high priest; כֹּֿהֲנִים׳כ Ezra 2:69 ; Neh 7:69 , 71 (van d. H. 7:70 ; 7:72 ); of Shebna's official tunic Isa 22:21 . כתף (√ of following; meaning unknown).","rootNote":"or כֻּתֹּנֶת ; from an unused root meaning to cover (compare 3802 );","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Sam 13 18","keyReferences":["2Sam 13 18","2Sam 13 19","2Sam 15 32","Exod 28 4","Exod 28 39","Exod 28 40","Exod 29 5","Exod 29 8"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":29,"occurrences":[{"reference":"2Sam 13 18","book":"2Sam","chapter":13,"verse":18,"englishText":"","sourceWord":"כְּתֹ֣נֶת","source":"hebrew","morph":"HNcfsc"},{"reference":"2Sam 13 19","book":"2Sam","chapter":13,"verse":19,"englishText":"","sourceWord":"וּ/כְתֹ֧נֶת","source":"hebrew","morph":"HC/Ncfsc"},{"reference":"2Sam 15 32","book":"2Sam","chapter":15,"verse":32,"englishText":"","sourceWord":"כֻּתָּנְתּ֔/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"Exod 28 4","book":"Exod","chapter":28,"verse":4,"englishText":"","sourceWord":"וּ/כְתֹ֥נֶת","source":"hebrew","morph":"HC/Ncfsc"},{"reference":"Exod 28 39","book":"Exod","chapter":28,"verse":39,"englishText":"","sourceWord":"הַ/כְּתֹ֣נֶת","source":"hebrew","morph":"HTd/Ncfsa"},{"reference":"Exod 28 40","book":"Exod","chapter":28,"verse":40,"englishText":"","sourceWord":"כֻתֳּנֹ֔ת","source":"hebrew","morph":"HNcfpa"},{"reference":"Exod 29 5","book":"Exod","chapter":29,"verse":5,"englishText":"","sourceWord":"הַ/כֻּתֹּ֔נֶת","source":"hebrew","morph":"HTd/Ncfsa"},{"reference":"Exod 29 8","book":"Exod","chapter":29,"verse":8,"englishText":"","sourceWord":"כֻּתֳּנֹֽת","source":"hebrew","morph":"HNcfpa"},{"reference":"Exod 39 27","book":"Exod","chapter":39