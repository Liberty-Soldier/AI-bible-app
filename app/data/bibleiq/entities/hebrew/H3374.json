om Job 28:28 ; יִרְאָה is defined by context 15:4 ; with suffixes these are usually object, fear of him Exod 20:20 (E), of thee Psa 5:8 ; 90:11 ; 119:38 ; Isa 63:17 , of me Jer 32:40 , but subject, thy fear (i.e. thy religion) Job 4:6 ; 22:4 . 4 יהוֺה יִרְאַת Psa 19:10 the fear of ׳י = the law as revered.","rootNote":"feminine of 3373 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Chr 19 9","keyReferences":["2Chr 19 9","2Sam 23 3","Deut 2 25","Exod 20 20","Ezek 1 18","Ezek 30 13","Gen 20 11","Isa 7 25"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":42,"occurrences":[{"reference":"2Chr 19 9","book":"2Chr","chapter":19,"verse":9,"englishText":"","sourceWord":"בְּ/יִרְאַ֣ת","source":"hebrew","morph":"HR/Ncfsc"},{"reference":"2Sam 23 3","book":"2Sam","chapter":23,"verse":3,"englishText":"","sourceWord":"יִרְאַ֥ת","source":"hebrew","morph":"HNcfsc"},{"reference":"Deut 2 25","book":"Deut","chapter":2,"verse":25,"englishText":"","sourceWord":"וְ/יִרְאָ֣תְ/ךָ֔","source":"hebrew","morph":"HC/Ncfsc/Sp2ms"},{"reference":"Exod 20 20","book":"Exod","chapter":20,"verse":20,"englishText":"","sourceWord":"יִרְאָת֛/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"Ezek 1 18","book":"Ezek","chapter":1,"verse":18,"englishText":"","sourceWord":"וְ/יִרְאָ֣ה","source":"hebrew","morph":"HC/Ncfsa"},{"reference":"Ezek 30 13","book":"Ezek","chapter":30,"verse":13,"englishText":"","sourceWord":"יִרְאָ֖ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Gen 20 11","book":"Gen","chapter":20,"verse":11,"englishText":"","sourceWord":"יִרְאַ֣ת","source":"hebrew","morph":"HNcfsc"},{"reference":"Isa 7 25","book":"Isa","chapter":7,"verse":25,"englishText":"","sourceWord":"יִרְאַ֖ת","source":"hebrew","morph":"HNcfsc"},{"reference":"Isa 11 2","book":"Isa","chapter":11,"verse":2,"englishText":"","sourceWord":"וְ/יִרְאַ֥ת","source":"hebrew","morph":"HC/Ncfsc"},{"reference":"Isa 11 3","book":"Isa","chapte