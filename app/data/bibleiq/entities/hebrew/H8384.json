 1:7 , 12 ; 2:22 ; Psa 105:33 . 2 fig , always plural: Num 13:23 (JE), Jer 24:1-2 ,(twice in verse); 24:3 (twice in verse); 24:5 , 8 ; 29:17 (all symbolic of Judaeans), 8:13 ( תּ ׳אֵין בַּתְּאֵנָה ), Neh 8:13 ; as medicament, ת ׳דְּבֶלֶת 2Kin 20:7 = Isa 38:21 ; הַבַּכֻּרוֺת תְּאֵנֵי Jer 24:2 the figs of early ripeness (compare Du). תַּאֲנִיָּה see [I. אנה ]. תְּאֻנִים see I. און .","rootNote":"or (in the singular, feminine) תְּאֵנָה ; perhaps of foreign derivation","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Kgs 5 5","keyReferences":["1Kgs 5 5","2Kgs 18 31","2Kgs 20 7","Amos 4 9","Deut 8 8","Gen 3 7","Hab 3 17","Hag 2 19"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":39,"occurrences":[{"reference":"1Kgs 5 5","book":"1Kgs","chapter":5,"verse":5,"englishText":"","sourceWord":"תְּאֵֽנָת֔/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"2Kgs 18 31","book":"2Kgs","chapter":18,"verse":31,"englishText":"","sourceWord":"תְּאֵֽנָת֔/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"2Kgs 20 7","book":"2Kgs","chapter":20,"verse":7,"englishText":"","sourceWord":"תְּאֵנִ֑ים","source":"hebrew","morph":"HNcfpa"},{"reference":"Amos 4 9","book":"Amos","chapter":4,"verse":9,"englishText":"","sourceWord":"וּ/תְאֵנֵי/כֶ֥ם","source":"hebrew","morph":"HC/Ncfpc/Sp2mp"},{"reference":"Deut 8 8","book":"Deut","chapter":8,"verse":8,"englishText":"","sourceWord":"וּ/תְאֵנָ֖ה","source":"hebrew","morph":"HC/Ncfsa"},{"reference":"Gen 3 7","book":"Gen","chapter":3,"verse":7,"englishText":"","sourceWord":"תְאֵנָ֔ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Hab 3 17","book":"Hab","chapter":3,"verse":17,"englishText":"","sourceWord":"תְאֵנָ֣ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Hag 2 19","book":"Hag","chapter":2,"verse":19,"englishText":"","sourceWord":"וְ/הַ/תְּאֵנָ֧ה","source":"hebrew","morph":"HC/Td/Ncfsa"},{"reference":"Hos 2 14","book":"Hos","chapter":2,"verse":1