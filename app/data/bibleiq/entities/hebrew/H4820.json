m 55:24, מ ׳אִישׁ וְעַוְלָה 43:1 ; מ ׳יַעֲשֶׁה Dan 11:23 . &#8212; II. מִרְמָה proper name.","rootNote":"from 7411 in the sense of deceiving ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Kgs 9 23","keyReferences":["2Kgs 9 23","Amos 8 5","Dan 8 25","Dan 11 23","Gen 27 35","Gen 34 13","Hos 12 1","Hos 12 8"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":39,"occurrences":[{"reference":"2Kgs 9 23","book":"2Kgs","chapter":9,"verse":23,"englishText":"","sourceWord":"מִרְמָ֥ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Amos 8 5","book":"Amos","chapter":8,"verse":5,"englishText":"","sourceWord":"מִרְמָֽה","source":"hebrew","morph":"HNcfsa"},{"reference":"Dan 8 25","book":"Dan","chapter":8,"verse":25,"englishText":"","sourceWord":"מִרְמָה֙","source":"hebrew","morph":"HNcfsa"},{"reference":"Dan 11 23","book":"Dan","chapter":11,"verse":23,"englishText":"","sourceWord":"מִרְמָ֑ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Gen 27 35","book":"Gen","chapter":27,"verse":35,"englishText":"","sourceWord":"בְּ/מִרְמָ֑ה","source":"hebrew","morph":"HR/Ncfsa"},{"reference":"Gen 34 13","book":"Gen","chapter":34,"verse":13,"englishText":"","sourceWord":"בְּ/מִרְמָ֖ה","source":"hebrew","morph":"HR/Ncfsa"},{"reference":"Hos 12 1","book":"Hos","chapter":12,"verse":1,"englishText":"","sourceWord":"וּ/בְ/מִרְמָ֖ה","source":"hebrew","morph":"HC/R/Ncfsa"},{"reference":"Hos 12 8","book":"Hos","chapter":12,"verse":8,"englishText":"","sourceWord":"מִרְמָ֖ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Isa 53 9","book":"Isa","chapter":53,"verse":9,"englishText":"","sourceWord":"מִרְמָ֖ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Jer 5 27","book":"Jer","chapter":5,"verse":27,"englishText":"","sourceWord":"מִרְמָ֑ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Jer 9 5","book":"Jer","chapter":9,"verse":5,"englishText":"","sourceWord":"מִרְמָ֑ה","source":"hebrew","morph":"HNcfsa"},{"re