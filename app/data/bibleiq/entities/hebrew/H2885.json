st often (only in Exodus) of rings for staves of ark, for curtains, for ephod, and other sacred furniture Exod 25:12 (3 t. in verse) + 35 t. in Exodus (all P).","rootNote":"from 2883 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"Esth 3 10","keyReferences":["Esth 3 10","Esth 3 12","Esth 8 2","Esth 8 8","Esth 8 8","Esth 8 10","Exod 25 12","Exod 25 12"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":50,"occurrences":[{"reference":"Esth 3 10","book":"Esth","chapter":3,"verse":10,"englishText":"","sourceWord":"טַבַּעְתּ֖/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"Esth 3 12","book":"Esth","chapter":3,"verse":12,"englishText":"","sourceWord":"בְּ/טַבַּ֥עַת","source":"hebrew","morph":"HR/Ncfsc"},{"reference":"Esth 8 2","book":"Esth","chapter":8,"verse":2,"englishText":"","sourceWord":"טַבַּעְתּ֗/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"Esth 8 8","book":"Esth","chapter":8,"verse":8,"englishText":"","sourceWord":"בְּ/טַבַּ֣עַת","source":"hebrew","morph":"HR/Ncfsc"},{"reference":"Esth 8 8","book":"Esth","chapter":8,"verse":8,"englishText":"","sourceWord":"בְּ/טַבַּ֥עַת","source":"hebrew","morph":"HR/Ncfsc"},{"reference":"Esth 8 10","book":"Esth","chapter":8,"verse":10,"englishText":"","sourceWord":"בְּ/טַבַּ֣עַת","source":"hebrew","morph":"HR/Ncfsc"},{"reference":"Exod 25 12","book":"Exod","chapter":25,"verse":12,"englishText":"","sourceWord":"טַבְּעֹ֣ת","source":"hebrew","morph":"HNcfpc"},{"reference":"Exod 25 12","book":"Exod","chapter":25,"verse":12,"englishText":"","sourceWord":"טַבָּעֹ֗ת","source":"hebrew","morph":"HNcfpa"},{"reference":"Exod 25 12","book":"Exod","chapter":25,"verse":12,"englishText":"","sourceWord":"טַבָּעֹ֔ת","source":"hebrew","morph":"HNcfpa"},{"reference":"Exod 25 14","book":"Exod","chapter":25,"verse":14,"englishText":"","sourceWord":"בַּ/טַּבָּעֹ֔ת","source":"hebrew","morph":"HRd/Ncfpa"},{"reference":"Exod 25 15","book":"Exod