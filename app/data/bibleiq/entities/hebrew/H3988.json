ֵס Job 7:5 my skin hath hardened and run (i. e. again, afresh; &gt; GHoffm Du read וַיִּמַּס , Bu וַיִּמָּאס , √ מסס ); 3 masculine plural יִמָּֽאֲסוּ מַיִם כְּמוֺ Psa 58:8 (figurative of annihilation of wicked). [ מַאֲפֶה ] see אפה . מַאְמֵּלְיָה מַאֲפֵל, , see אפל . מאץ (compare Arabic a kind of white camel, whence Lag BN 29 proposes מָאֹץ for the difficult אָמֹץ ( אֲמֻצִּים ) Zech 6:3 , 7 ).","rootNote":"a primitive root;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Sam 8 7","keyReferences":["1Sam 8 7","1Sam 8 7","1Sam 10 19","1Sam 15 23","1Sam 15 23","1Sam 15 26","1Sam 15 26","1Sam 16 1"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":76,"occurrences":[{"reference":"1Sam 8 7","book":"1Sam","chapter":8,"verse":7,"englishText":"","sourceWord":"מָאָ֔סוּ","source":"hebrew","morph":"HVqp3cp"},{"reference":"1Sam 8 7","book":"1Sam","chapter":8,"verse":7,"englishText":"","sourceWord":"מָאֲס֖וּ","source":"hebrew","morph":"HVqp3cp"},{"reference":"1Sam 10 19","book":"1Sam","chapter":10,"verse":19,"englishText":"","sourceWord":"מְאַסְתֶּ֣ם","source":"hebrew","morph":"HVqp2mp"},{"reference":"1Sam 15 23","book":"1Sam","chapter":15,"verse":23,"englishText":"","sourceWord":"מָאַ֨סְתָּ֙","source":"hebrew","morph":"HVqp2ms"},{"reference":"1Sam 15 23","book":"1Sam","chapter":15,"verse":23,"englishText":"","sourceWord":"וַ/יִּמְאָסְ/ךָ֖","source":"hebrew","morph":"HC/Vqw3ms/Sp2ms"},{"reference":"1Sam 15 26","book":"1Sam","chapter":15,"verse":26,"englishText":"","sourceWord":"מָאַ֨סְתָּה֙","source":"hebrew","morph":"HVqp2ms"},{"reference":"1Sam 15 26","book":"1Sam","chapter":15,"verse":26,"englishText":"","sourceWord":"וַ/יִּמְאָסְ/ךָ֣","source":"hebrew","morph":"HC/Vqw3ms/Sp2ms"},{"reference":"1Sam 16 1","book":"1Sam","chapter":16,"verse":1,"englishText":"","sourceWord":"מְאַסְתִּ֔י/ו","source":"hebrew","morph":"HVqp1cs/Sp3ms"},{"reference":"1Sam 16 7","book":"1Sam","chapter":16,"verse":7,"eng