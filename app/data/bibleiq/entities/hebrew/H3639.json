׳נשׂא bear ignominy , 16:52 (twice in verse) (|| בושׁ ), 16:54 ( נִכְלַם in || clause); 32:24-25 , 30 (all + בוֺר אֶתיֿוֺרְדֵי with those who go down to the pit ; reference to ignominious death), 36:7 ; 39:26 (si vera 1. = bear the humiliating sense of underserved kindness from ׳י ; but text dubious, Hi Co, q. v., [ ׳כ ] נשׁו ; Sm Da defend); הַגּוֺיִם כְּלִמַּת נאשׂ , i.e. caused by the nations, Ezekiel 34:39; 36:6 ; also 36:15 (|| עַמִּים חֶרְמַּת ), probably also Psa 89:51 (read כְּלִמַּת , compare VB Che Bae); ׳וְנ עָשׂוּ אֲשֶׁר יְתוֺעֲבוֺתָם כְּלִמָּתָם Ezek 44:13 .","rootNote":"from 3637 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"Ezek 16 52","keyReferences":["Ezek 16 52","Ezek 16 52","Ezek 16 54","Ezek 16 63","Ezek 32 24","Ezek 32 25","Ezek 32 30","Ezek 34 29"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":30,"occurrences":[{"reference":"Ezek 16 52","book":"Ezek","chapter":16,"verse":52,"englishText":"","sourceWord":"כְלִמָּתֵ֗/ךְ","source":"hebrew","morph":"HNcfsc/Sp2fs"},{"reference":"Ezek 16 52","book":"Ezek","chapter":16,"verse":52,"englishText":"","sourceWord":"כְלִמָּתֵ֔/ךְ","source":"hebrew","morph":"HNcfsc/Sp2fs"},{"reference":"Ezek 16 54","book":"Ezek","chapter":16,"verse":54,"englishText":"","sourceWord":"כְלִמָּתֵ֔/ךְ","source":"hebrew","morph":"HNcfsc/Sp2fs"},{"reference":"Ezek 16 63","book":"Ezek","chapter":16,"verse":63,"englishText":"","sourceWord":"כְּלִמָּתֵ֑/ךְ","source":"hebrew","morph":"HNcfsc/Sp2fs"},{"reference":"Ezek 32 24","book":"Ezek","chapter":32,"verse":24,"englishText":"","sourceWord":"כְלִמָּתָ֖/ם","source":"hebrew","morph":"HNcfsc/Sp3mp"},{"reference":"Ezek 32 25","book":"Ezek","chapter":32,"verse":25,"englishText":"","sourceWord":"כְלִמָּתָ/ם֙","source":"hebrew","morph":"HNcfsc/Sp3mp"},{"reference":"Ezek 32 30","book":"Ezek","chapter":32,"verse":30,"englishText":"","sourceWord":"כְלִמָּתָ֖/ם","source":"hebrew","morph":"HNcfsc/Sp3mp"},{"refere