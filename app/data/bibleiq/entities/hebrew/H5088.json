3 ; תּוֺדָה 50:14 ; 56:13 ; שְׁלָמִים Num 15:8 ; opposed to נדבה Lev 7:16 ; Num 15:3 ; 29:39 (P), Lev 22:18 , 21 , 23 ; 23:38 (H), Deut 12:6 , 17 ; 1Sam 1:21 ; Jonah 1:16 . 6 once of idolatry Jer 44:25 ( ׳נ הַשָּׁמַיִם לִמְלֶכֶת לְקַטֵּר ). — Vbs. used are: נָדַר q. v.; שִׁלֵּם pay 2Sam 15:7 12 t.; עשׂה Judg 11:39 ; Jer 44:25 ; נשׂא Deut 12:26 ; קום Num 30:5 ; 30:8 ; 30:12 ; 30:15 ; הֵקִים Jer 44:25 ; אסּר Num 30:14 ; מִּלֵּא Lev 22:21 ; 27:2 ; Num 15:3 , 8 לנ ׳פלּא ׳נ 6:2 ; הֵפֵר 30:9 . (See these verbs) נִהַּ see נוהּ .","rootNote":"or נֵדֶר ; from 5087 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Sam 1 11","keyReferences":["1Sam 1 11","1Sam 1 21","2Sam 15 7","2Sam 15 8","Deut 12 6","Deut 12 11","Deut 12 17","Deut 12 26"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":60,"occurrences":[{"reference":"1Sam 1 11","book":"1Sam","chapter":1,"verse":11,"englishText":"","sourceWord":"נֶ֜דֶר","source":"hebrew","morph":"HNcmsa"},{"reference":"1Sam 1 21","book":"1Sam","chapter":1,"verse":21,"englishText":"","sourceWord":"נִדְרֽ/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"2Sam 15 7","book":"2Sam","chapter":15,"verse":7,"englishText":"","sourceWord":"נִדְרִ֛/י","source":"hebrew","morph":"HNcmsc/Sp1cs"},{"reference":"2Sam 15 8","book":"2Sam","chapter":15,"verse":8,"englishText":"","sourceWord":"נֵ֨דֶר֙","source":"hebrew","morph":"HNcmsa"},{"reference":"Deut 12 6","book":"Deut","chapter":12,"verse":6,"englishText":"","sourceWord":"וְ/נִדְרֵי/כֶם֙","source":"hebrew","morph":"HC/Ncmpc/Sp2mp"},{"reference":"Deut 12 11","book":"Deut","chapter":12,"verse":11,"englishText":"","sourceWord":"נִדְרֵי/כֶ֔ם","source":"hebrew","morph":"HNcmpc/Sp2mp"},{"reference":"Deut 12 17","book":"Deut","chapter":12,"verse":17,"englishText":"","sourceWord":"נְדָרֶ֨י/ךָ֙","source":"hebrew","morph":"HNcmpc/Sp2ms"},{"reference":"Deut 12 26","book":"Deut","chapter":12,"verse":26,"englishText":"","sourceWo