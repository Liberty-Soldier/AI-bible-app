er them Eccl 5:7 so Ew Zö and others, but Vrss De Now and others higher (earthly), potentates over them . 3 haughty Psa 138:6 ; Isa 5:15 ; 10:33 ; 1Sam 2:3 ; גְּבַהּעֵֿינַיִם Psa 101:5 ; ׳ג לֵב Prov 16:5 ; ׳ג רוּחַ Eccl 7:8 . 4. noun [masculine] loftiness , קוֺמַתוֺ גִּבֹהַּ 1Sam 16:7 ; compare גָּדוֺל 10 , p. 153.","rootNote":"or גָּבוֹהַּ ; (fully) from 1361 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Kgs 14 23","keyReferences":["1Kgs 14 23","1Sam 2 3","1Sam 2 3","1Sam 9 2","1Sam 16 7","2Kgs 17 10","Dan 8 3","Dan 8 3"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":37,"occurrences":[{"reference":"1Kgs 14 23","book":"1Kgs","chapter":14,"verse":23,"englishText":"","sourceWord":"גְבֹהָ֔ה","source":"hebrew","morph":"HAafsa"},{"reference":"1Sam 2 3","book":"1Sam","chapter":2,"verse":3,"englishText":"","sourceWord":"גְּבֹהָ֣ה","source":"hebrew","morph":"HAafsa"},{"reference":"1Sam 2 3","book":"1Sam","chapter":2,"verse":3,"englishText":"","sourceWord":"גְבֹהָ֔ה","source":"hebrew","morph":"HAafsa"},{"reference":"1Sam 9 2","book":"1Sam","chapter":9,"verse":2,"englishText":"","sourceWord":"גָּבֹ֖הַּ","source":"hebrew","morph":"HAamsa"},{"reference":"1Sam 16 7","book":"1Sam","chapter":16,"verse":7,"englishText":"","sourceWord":"גְּבֹ֥הַּ","source":"hebrew","morph":"HAamsc"},{"reference":"2Kgs 17 10","book":"2Kgs","chapter":17,"verse":10,"englishText":"","sourceWord":"גְבֹהָ֔ה","source":"hebrew","morph":"HAafsa"},{"reference":"Dan 8 3","book":"Dan","chapter":8,"verse":3,"englishText":"","sourceWord":"גְּבֹה֗וֹת","source":"hebrew","morph":"HAafpa"},{"reference":"Dan 8 3","book":"Dan","chapter":8,"verse":3,"englishText":"","sourceWord":"גְּבֹהָ֣ה","source":"hebrew","morph":"HAafsa"},{"reference":"Dan 8 3","book":"Dan","chapter":8,"verse":3,"englishText":"","sourceWord":"וְ/הַ֨/גְּבֹהָ֔ה","source":"hebrew","morph":"HC/Td/Aafsa"},{"reference":"Deut 3 5","book":"Deut","chapter":3,"verse":5