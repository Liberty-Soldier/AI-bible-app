ticus; Num 7:16 19 t. Numbers; עִזִּים שְׂעִירַת a single she-goat Lev 4:28 ; 5:6 ; זִּים עְפִרֵי 2Chr 29:21 he-goats. 4 עִזִּים = goats' hair, as material 1Sam 19:13 , 16 ; Exod 25:4 6 t. P ( 35:26 object of טָווּ !). 5 in simile עִזִּים חֲשַׂפֵי 1Kin 20:27 (see [ חָשִׂיף ]); הָע ׳כְּעֵדַר Song 4:1 ; 6:5 , of flowing, undulating hair. 6 הָע ׳צְפִיר Du Song 8:5 , 8 he-goat in vision. ענז (√ of following; see Biblical Hebrew עֵז ענז, ).","rootNote":"from 5810 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Kgs 20 27","keyReferences":["1Kgs 20 27","1Sam 16 20","1Sam 19 13","1Sam 19 16","1Sam 25 2","2Chr 29 21","2Chr 35 7","Dan 8 5"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":74,"occurrences":[{"reference":"1Kgs 20 27","book":"1Kgs","chapter":20,"verse":27,"englishText":"","sourceWord":"עִזִּ֔ים","source":"hebrew","morph":"HNcfpa"},{"reference":"1Sam 16 20","book":"1Sam","chapter":16,"verse":20,"englishText":"","sourceWord":"עִזִּ֖ים","source":"hebrew","morph":"HNcfpa"},{"reference":"1Sam 19 13","book":"1Sam","chapter":19,"verse":13,"englishText":"","sourceWord":"הָֽ/עִזִּ֔ים","source":"hebrew","morph":"HTd/Ncfpa"},{"reference":"1Sam 19 16","book":"1Sam","chapter":19,"verse":16,"englishText":"","sourceWord":"הָ/עִזִּ֖ים","source":"hebrew","morph":"HTd/Ncfpa"},{"reference":"1Sam 25 2","book":"1Sam","chapter":25,"verse":2,"englishText":"","sourceWord":"עִזִּ֑ים","source":"hebrew","morph":"HNcfpa"},{"reference":"2Chr 29 21","book":"2Chr","chapter":29,"verse":21,"englishText":"","sourceWord":"עִזִּ֤ים","source":"hebrew","morph":"HNcfpa"},{"reference":"2Chr 35 7","book":"2Chr","chapter":35,"verse":7,"englishText":"","sourceWord":"עִזִּים֮","source":"hebrew","morph":"HNcfpa"},{"reference":"Dan 8 5","book":"Dan","chapter":8,"verse":5,"englishText":"","sourceWord":"הָֽ/עִזִּים֙","source":"hebrew","morph":"HTd/Ncfpa"},{"reference":"Dan 8 8","book":"Dan","chapter":8,"verse":8,"englishText":