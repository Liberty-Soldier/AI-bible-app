ֵּא , || תועבה ), 23:21 , 27 (|| זְנוּתֵךְ ), 23:29 ( וְתַזְנוּתָ֑יִךְ וְזִמָּתֵךְ זְנוּנַיִךְ עֶרְוַת ), 23:35 (|| תַּזְנוּתָ֑יִךְ ), 23:44 ( הַזּ ׳אִשּׁוֺת , Co ז ׳לעשׂות ), 23:48 ; 23:48 ; 23:49 (|| גִלּוּלֵיכֶן חֲטָאֵי ), 24:13 . [In 16:27 , 43 ; 24:13 strike out Co, chiefly on internal grounds.]","rootNote":"or זַמָּה ; from 2161 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"Ezek 16 27","keyReferences":["Ezek 16 27","Ezek 16 43","Ezek 16 58","Ezek 22 9","Ezek 22 11","Ezek 23 21","Ezek 23 27","Ezek 23 29"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":29,"occurrences":[{"reference":"Ezek 16 27","book":"Ezek","chapter":16,"verse":27,"englishText":"","sourceWord":"זִמָּֽה","source":"hebrew","morph":"HNcfsa"},{"reference":"Ezek 16 43","book":"Ezek","chapter":16,"verse":43,"englishText":"","sourceWord":"הַ/זִּמָּ֔ה","source":"hebrew","morph":"HTd/Ncfsa"},{"reference":"Ezek 16 58","book":"Ezek","chapter":16,"verse":58,"englishText":"","sourceWord":"זִמָּתֵ֥/ךְ","source":"hebrew","morph":"HNcfsc/Sp2fs"},{"reference":"Ezek 22 9","book":"Ezek","chapter":22,"verse":9,"englishText":"","sourceWord":"זִמָּ֖ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Ezek 22 11","book":"Ezek","chapter":22,"verse":11,"englishText":"","sourceWord":"בְ/זִמָּ֑ה","source":"hebrew","morph":"HR/Ncfsa"},{"reference":"Ezek 23 21","book":"Ezek","chapter":23,"verse":21,"englishText":"","sourceWord":"זִמַּ֣ת","source":"hebrew","morph":"HNcfsc"},{"reference":"Ezek 23 27","book":"Ezek","chapter":23,"verse":27,"englishText":"","sourceWord":"זִמָּתֵ/ךְ֙","source":"hebrew","morph":"HNcfsc/Sp2fs"},{"reference":"Ezek 23 29","book":"Ezek","chapter":23,"verse":29,"englishText":"","sourceWord":"וְ/זִמָּתֵ֖/ךְ","source":"hebrew","morph":"HC/Ncfsc/Sp2fs"},{"reference":"Ezek 23 35","book":"Ezek","chapter":23,"verse":35,"englishText":"","sourceWord":"זִמָּתֵ֖/ךְ","source":"hebrew","morph":"HNcfsc/Sp2fs"},{"reference":"E