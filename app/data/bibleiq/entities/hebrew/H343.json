 צָרה יוֺם אֹבֶד יוֺם 46:12 ; 46:14 , compare יהוה יוֺם 46:15 ).","rootNote":"from the same as 181 (in the sense of bending down);","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Sam 22 19","keyReferences":["2Sam 22 19","Deut 32 35","Ezek 35 5","Jer 18 17","Jer 46 21","Jer 48 16","Jer 49 8","Jer 49 32"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":24,"occurrences":[{"reference":"2Sam 22 19","book":"2Sam","chapter":22,"verse":19,"englishText":"","sourceWord":"אֵידִ֑/י","source":"hebrew","morph":"HNcmsc/Sp1cs"},{"reference":"Deut 32 35","book":"Deut","chapter":32,"verse":35,"englishText":"","sourceWord":"אֵידָ֔/ם","source":"hebrew","morph":"HNcmsc/Sp3mp"},{"reference":"Ezek 35 5","book":"Ezek","chapter":35,"verse":5,"englishText":"","sourceWord":"אֵידָ֔/ם","source":"hebrew","morph":"HNcmsc/Sp3mp"},{"reference":"Jer 18 17","book":"Jer","chapter":18,"verse":17,"englishText":"","sourceWord":"אֵידָֽ/ם","source":"hebrew","morph":"HNcmsc/Sp3mp"},{"reference":"Jer 46 21","book":"Jer","chapter":46,"verse":21,"englishText":"","sourceWord":"אֵידָ֛/ם","source":"hebrew","morph":"HNcmsc/Sp3mp"},{"reference":"Jer 48 16","book":"Jer","chapter":48,"verse":16,"englishText":"","sourceWord":"אֵיד","source":"hebrew","morph":"HNcmsc"},{"reference":"Jer 49 8","book":"Jer","chapter":49,"verse":8,"englishText":"","sourceWord":"אֵ֥יד","source":"hebrew","morph":"HNcmsc"},{"reference":"Jer 49 32","book":"Jer","chapter":49,"verse":32,"englishText":"","sourceWord":"אֵידָ֖/ם","source":"hebrew","morph":"HNcmsc/Sp3mp"},{"reference":"Job 18 12","book":"Job","chapter":18,"verse":12,"englishText":"","sourceWord":"וְ֝/אֵ֗יד","source":"hebrew","morph":"HC/Ncmsa"},{"reference":"Job 21 17","book":"Job","chapter":21,"verse":17,"englishText":"","sourceWord":"אֵידָ֑/ם","source":"hebrew","morph":"HNcmsc/Sp3mp"},{"reference":"Job 21 30","book":"Job","chapter":21,"verse":30,"englishText":"","sourceWord":"אֵ֭יד","source":"heb