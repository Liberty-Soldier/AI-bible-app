ָה +? Judah: a. son of Ethan (!) 1Chr 2:8 . b. 1Chr 2:38 ; 2:39 . &#8212; For עֲזַרְיָהוּ 2Chr 22:6 read אֲחַזְיָה compare 22:7 . ** עֲזַרְיָה occurs also Jer 43:2 = (וִ)יזַנְיָה 42:1 (see above); and as friend of Danial Dan 1:6 ; 1:7 ; 1:11 ; 1:19 . עֲזַרְיָה proper name, masculine comrade of Daniel (Biblical Hebrew id. ; Dan 1:6 +); — 2:17 , = נְגוֺ עֲבֵד 2:49 +. עֵטָא see יעט .","rootNote":"or עֲזַרְיָהוּ ; from 5826 and 3050 ; Jah has helped ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Chr 2 8","keyReferences":["1Chr 2 8","1Chr 2 38","1Chr 2 39","1Chr 3 12","1Chr 5 35","1Chr 5 35","1Chr 5 36","1Chr 5 37"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":48,"occurrences":[{"reference":"1Chr 2 8","book":"1Chr","chapter":2,"verse":8,"englishText":"","sourceWord":"עֲזַרְיָֽה","source":"hebrew","morph":"HNp"},{"reference":"1Chr 2 38","book":"1Chr","chapter":2,"verse":38,"englishText":"","sourceWord":"עֲזַרְיָֽה","source":"hebrew","morph":"HNp"},{"reference":"1Chr 2 39","book":"1Chr","chapter":2,"verse":39,"englishText":"","sourceWord":"וַ/עֲזַרְיָה֙","source":"hebrew","morph":"HC/Np"},{"reference":"1Chr 3 12","book":"1Chr","chapter":3,"verse":12,"englishText":"","sourceWord":"עֲזַרְיָ֥ה","source":"hebrew","morph":"HNp"},{"reference":"1Chr 5 35","book":"1Chr","chapter":5,"verse":35,"englishText":"","sourceWord":"עֲזַרְיָ֔ה","source":"hebrew","morph":"HNp"},{"reference":"1Chr 5 35","book":"1Chr","chapter":5,"verse":35,"englishText":"","sourceWord":"וַ/עֲזַרְיָ֖ה","source":"hebrew","morph":"HC/Np"},{"reference":"1Chr 5 36","book":"1Chr","chapter":5,"verse":36,"englishText":"","sourceWord":"עֲזַרְיָ֑ה","source":"hebrew","morph":"HNp"},{"reference":"1Chr 5 37","book":"1Chr","chapter":5,"verse":37,"englishText":"","sourceWord":"עֲזַרְיָ֖ה","source":"hebrew","morph":"HNp"},{"reference":"1Chr 5 39","book":"1Chr","chapter":5,"verse":39,"englishText":"","sourceWord":"עֲזַרְיָֽה","source":