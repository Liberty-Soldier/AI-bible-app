רֶךְ ), fully ׳ע הַנִּשְׁחָתוֺת 20:44 (|| ׳ד הָרָעִים ); 21:29 ; Zeph 3:11 ; כָּלעֿ ׳הִשְׁחִיתוּ 3:7 .","rootNote":"or עֲלִלָה ; from 5953 in the sense of effecting ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Chr 16 8","keyReferences":["1Chr 16 8","1Sam 2 3","Deut 22 14","Deut 22 17","Ezek 14 22","Ezek 14 23","Ezek 20 43","Ezek 20 44"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":24,"occurrences":[{"reference":"1Chr 16 8","book":"1Chr","chapter":16,"verse":8,"englishText":"","sourceWord":"עֲלִילֹתָֽי/ו","source":"hebrew","morph":"HNcfpc/Sp3ms"},{"reference":"1Sam 2 3","book":"1Sam","chapter":2,"verse":3,"englishText":"","sourceWord":"עֲלִלֽוֹת","source":"hebrew","morph":"HNcfpa"},{"reference":"Deut 22 14","book":"Deut","chapter":22,"verse":14,"englishText":"","sourceWord":"עֲלִילֹ֣ת","source":"hebrew","morph":"HNcfpc"},{"reference":"Deut 22 17","book":"Deut","chapter":22,"verse":17,"englishText":"","sourceWord":"עֲלִילֹ֨ת","source":"hebrew","morph":"HNcfpc"},{"reference":"Ezek 14 22","book":"Ezek","chapter":14,"verse":22,"englishText":"","sourceWord":"עֲלִֽילוֹתָ֑/ם","source":"hebrew","morph":"HNcfpc/Sp3mp"},{"reference":"Ezek 14 23","book":"Ezek","chapter":14,"verse":23,"englishText":"","sourceWord":"עֲלִֽילוֹתָ֑/ם","source":"hebrew","morph":"HNcfpc/Sp3mp"},{"reference":"Ezek 20 43","book":"Ezek","chapter":20,"verse":43,"englishText":"","sourceWord":"עֲלִיל֣וֹתֵי/כֶ֔ם","source":"hebrew","morph":"HNcfpc/Sp2mp"},{"reference":"Ezek 20 44","book":"Ezek","chapter":20,"verse":44,"englishText":"","sourceWord":"וְ/כַ/עֲלִילֽוֹתֵי/כֶ֤ם","source":"hebrew","morph":"HC/R/Ncfpc/Sp2mp"},{"reference":"Ezek 21 29","book":"Ezek","chapter":21,"verse":29,"englishText":"","sourceWord":"עֲלִילֽוֹתֵי/כֶ֑ם","source":"hebrew","morph":"HNcfpc/Sp2mp"},{"reference":"Ezek 24 14","book":"Ezek","chapter":24,"verse":14,"englishText":"","sourceWord":"וְ/כַ/עֲלִילוֹתַ֨יִ/ךְ֙","source":"hebrew","morph":"HC/