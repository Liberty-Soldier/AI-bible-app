oth J), Josh 6:26 ; 1Kin 16:34 , opposed to רַב Gen 25:23 (J), compare יְשִׁישִׁים ואתם לְיָמִים ׳צ אני Job 32:6 ; of daughter (sister), opposed to הַבְּכִירָה Gen 19:31 , 34 , 35 , 38 (J) 29:26 (E); — here belongs also לימים מִמֶּנִּי צְעַירִים Job 30:1 , si vera lectio; GHBWr Siegf Bu strike out לימים ממני ; ᵐ5 ἐλἁχιστοι ); put then under 1b.","rootNote":"or צָעוֹר ; from 6819 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Kgs 16 34","keyReferences":["1Kgs 16 34","1Sam 9 21","Gen 19 31","Gen 19 34","Gen 19 35","Gen 19 38","Gen 25 23","Gen 29 26"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":24,"occurrences":[{"reference":"1Kgs 16 34","book":"1Kgs","chapter":16,"verse":34,"englishText":"","sourceWord":"צְעִיר/וֹ֙","source":"hebrew","morph":"HAamsc/Sp3ms"},{"reference":"1Sam 9 21","book":"1Sam","chapter":9,"verse":21,"englishText":"","sourceWord":"הַ/צְּעִרָ֔ה","source":"hebrew","morph":"HTd/Aafsa"},{"reference":"Gen 19 31","book":"Gen","chapter":19,"verse":31,"englishText":"","sourceWord":"הַ/צְּעִירָ֖ה","source":"hebrew","morph":"HTd/Aafsa"},{"reference":"Gen 19 34","book":"Gen","chapter":19,"verse":34,"englishText":"","sourceWord":"הַ/צְּעִירָ֔ה","source":"hebrew","morph":"HTd/Aafsa"},{"reference":"Gen 19 35","book":"Gen","chapter":19,"verse":35,"englishText":"","sourceWord":"הַ/צְּעִירָה֙","source":"hebrew","morph":"HTd/Aafsa"},{"reference":"Gen 19 38","book":"Gen","chapter":19,"verse":38,"englishText":"","sourceWord":"וְ/הַ/צְּעִירָ֤ה","source":"hebrew","morph":"HC/Td/Aafsa"},{"reference":"Gen 25 23","book":"Gen","chapter":25,"verse":23,"englishText":"","sourceWord":"צָעִֽיר","source":"hebrew","morph":"HAamsa"},{"reference":"Gen 29 26","book":"Gen","chapter":29,"verse":26,"englishText":"","sourceWord":"הַ/צְּעִירָ֖ה","source":"hebrew","morph":"HTd/Aafsa"},{"reference":"Gen 43 33","book":"Gen","chapter":43,"verse":33,"englishText":"","sourceWord":"וְ/הַ/צָּעִ֖יר","source":"