ְגֹד Psa 35:3 ; || קֶשֶׁת 46:10 . 2. a. shaft of spear is ח ׳עֵץ 2Sam 23:7 ; 1Chr 20:5 + 1Sam 17:7 Qr (doubtless right; Kt חץ ). b. spear-head ח ׳לַהֶבֶת 1Sam 17:7 , compare ח ׳לַהַב Job 39:23 ; ח ׳בְּרַק Nahum 3:3 ; Hab 3:11 . c. butt of spear ח ׳אַחֲרֵי 2Sam 2:23 . 3 metaphor of teeth of lions Psalm 2Sam 57:5 (|| חצים ; figurative of Psalmist's enemies).","rootNote":"from 2583 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Chr 11 11","keyReferences":["1Chr 11 11","1Chr 11 20","1Chr 11 23","1Chr 11 23","1Chr 11 23","1Chr 12 35","1Chr 20 5","1Sam 13 19"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":48,"occurrences":[{"reference":"1Chr 11 11","book":"1Chr","chapter":11,"verse":11,"englishText":"","sourceWord":"חֲנִית֛/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"1Chr 11 20","book":"1Chr","chapter":11,"verse":20,"englishText":"","sourceWord":"חֲנִית֔/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"1Chr 11 23","book":"1Chr","chapter":11,"verse":23,"englishText":"","sourceWord":"חֲנִית֙","source":"hebrew","morph":"HNcfsa"},{"reference":"1Chr 11 23","book":"1Chr","chapter":11,"verse":23,"englishText":"","sourceWord":"הַ/חֲנִית֙","source":"hebrew","morph":"HTd/Ncfsa"},{"reference":"1Chr 11 23","book":"1Chr","chapter":11,"verse":23,"englishText":"","sourceWord":"בַּ/חֲנִיתֽ/וֹ","source":"hebrew","morph":"HR/Ncfsc/Sp3ms"},{"reference":"1Chr 12 35","book":"1Chr","chapter":12,"verse":35,"englishText":"","sourceWord":"וַ/חֲנִ֔ית","source":"hebrew","morph":"HC/Ncfsa"},{"reference":"1Chr 20 5","book":"1Chr","chapter":20,"verse":5,"englishText":"","sourceWord":"חֲנִית֔/וֹ","source":"hebrew","morph":"HNcfsc/Sp3ms"},{"reference":"1Sam 13 19","book":"1Sam","chapter":13,"verse":19,"englishText":"","sourceWord":"חֲנִֽית","source":"hebrew","morph":"HNcfsa"},{"reference":"1Sam 13 22","book":"1Sam","chapter":13,"verse":22,"englishText":"","sourceWord":"וַ/חֲנִית֙","source