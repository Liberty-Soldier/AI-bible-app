ccusative of thing + עַל person against whom Dan 3:29 . 2 relate, tell: followed by accusative of thing Dan 4:6 ; 4:15 ; 7:1 , + ל person 2:4 , 9 , 7 ; 7:16 (accusative of thing omitted), + קְָדָם person 2:36 ; 4:4 ; 4:5 . 3 command: followed by infinitive Dan 2:12 , 46 6 t. Daniel; followed by finite verb 5:29 ; 6:17 ; 6:23 ; followed by ל person + or. rect. 3:4 [pl. with indefinite subject, for passive, K § 76 e , so 4:23 ].","rootNote":"(Aramaic) corresponding to 559","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"Dan 2 4","keyReferences":["Dan 2 4","Dan 2 5","Dan 2 7","Dan 2 7","Dan 2 8","Dan 2 9","Dan 2 9","Dan 2 10"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":71,"occurrences":[{"reference":"Dan 2 4","book":"Dan","chapter":2,"verse":4,"englishText":"","sourceWord":"אֱמַ֥ר","source":"hebrew","morph":"AVqv2ms"},{"reference":"Dan 2 5","book":"Dan","chapter":2,"verse":5,"englishText":"","sourceWord":"וְ/אָמַ֣ר","source":"hebrew","morph":"AC/Vqrmsa"},{"reference":"Dan 2 7","book":"Dan","chapter":2,"verse":7,"englishText":"","sourceWord":"וְ/אָמְרִ֑ין","source":"hebrew","morph":"AC/Vqrmpa"},{"reference":"Dan 2 7","book":"Dan","chapter":2,"verse":7,"englishText":"","sourceWord":"יֵאמַ֥ר","source":"hebrew","morph":"AVqi3ms"},{"reference":"Dan 2 8","book":"Dan","chapter":2,"verse":8,"englishText":"","sourceWord":"וְ/אָמַ֔ר","source":"hebrew","morph":"AC/Vqrmsa"},{"reference":"Dan 2 9","book":"Dan","chapter":2,"verse":9,"englishText":"","sourceWord":"לְ/מֵאמַ֣ר","source":"hebrew","morph":"AR/Vqc"},{"reference":"Dan 2 9","book":"Dan","chapter":2,"verse":9,"englishText":"","sourceWord":"אֱמַ֣רוּ","source":"hebrew","morph":"AVqv2mp"},{"reference":"Dan 2 10","book":"Dan","chapter":2,"verse":10,"englishText":"","sourceWord":"וְ/אָ֣מְרִ֔ין","source":"hebrew","morph":"AC/Vqrmpa"},{"reference":"Dan 2 12","book":"Dan","chapter":2,"verse":12,"englishText":"","sourceWord":"וַ/אֲמַר֙","source":