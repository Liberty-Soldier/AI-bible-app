 in verse); 27:4 17 t. 27 ( עֶרְכְּךָ כֶּסֶף see 15; 27:19 , הָעֶרְכְּךָ מִכְסַת 27:23 [strike out ךְָ ], compare 27:23 b [strike out id. ]), Num 18:16 . &#8212; Job 28:13 read ᵐ5 דַּרְכָּהּ Di and others","rootNote":"from 6186 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Kgs 12 5","keyReferences":["2Kgs 12 5","2Kgs 23 35","Exod 40 4","Exod 40 23","Job 28 13","Job 41 4","Judg 17 10","Lev 5 15"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":33,"occurrences":[{"reference":"2Kgs 12 5","book":"2Kgs","chapter":12,"verse":5,"englishText":"","sourceWord":"עֶרְכּ֑/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"2Kgs 23 35","book":"2Kgs","chapter":23,"verse":35,"englishText":"","sourceWord":"כְּ/עֶרְכּ֗/וֹ","source":"hebrew","morph":"HR/Ncmsc/Sp3ms"},{"reference":"Exod 40 4","book":"Exod","chapter":40,"verse":4,"englishText":"","sourceWord":"עֶרְכּ֑/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"Exod 40 23","book":"Exod","chapter":40,"verse":23,"englishText":"","sourceWord":"עֵ֥רֶךְ","source":"hebrew","morph":"HNcmsc"},{"reference":"Job 28 13","book":"Job","chapter":28,"verse":13,"englishText":"","sourceWord":"עֶרְכָּ֑/הּ","source":"hebrew","morph":"HNcmsc/Sp3fs"},{"reference":"Job 41 4","book":"Job","chapter":41,"verse":4,"englishText":"","sourceWord":"עֶרְכּֽ/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"Judg 17 10","book":"Judg","chapter":17,"verse":10,"englishText":"","sourceWord":"וְ/עֵ֥רֶךְ","source":"hebrew","morph":"HC/Ncmsc"},{"reference":"Lev 5 15","book":"Lev","chapter":5,"verse":15,"englishText":"","sourceWord":"בְּ/עֶרְכְּ/ךָ֛","source":"hebrew","morph":"HR/Ncmsc/Sp2ms"},{"reference":"Lev 5 18","book":"Lev","chapter":5,"verse":18,"englishText":"","sourceWord":"בְּ/עֶרְכְּ/ךָ֥","source":"hebrew","morph":"HR/Ncmsc/Sp2ms"},{"reference":"Lev 5 25","book":"Lev","chapter":5,"verse":25,"englishText":"","sourceWord":"בְּ/עֶרְכְּ/ךָ֥","sourc