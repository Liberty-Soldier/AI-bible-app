ompare Di) Num 19:9 , 13 , 20 , 21 (twice in verse); 31:23 . 2 figurative (with allusion to cerem. usage), impure thing , Ezek 7:19-20 , (of gold), Lam 1:17 (of Jerusalem); of idolatry, immorality, etc., 2Chr 29:5 ; Ezra 9:11 ( נִדָּה אֶרֶץ ), 9:11 , Zech 13:1 ( וּלְנִדָּה לְחַטַּאת ).","rootNote":"from 5074 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Chr 29 5","keyReferences":["2Chr 29 5","Ezek 7 19","Ezek 7 20","Ezek 18 6","Ezek 22 10","Ezek 36 17","Ezra 9 11","Ezra 9 11"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":29,"occurrences":[{"reference":"2Chr 29 5","book":"2Chr","chapter":29,"verse":5,"englishText":"","sourceWord":"הַ/נִּדָּ֖ה","source":"hebrew","morph":"HTd/Ncfsa"},{"reference":"Ezek 7 19","book":"Ezek","chapter":7,"verse":19,"englishText":"","sourceWord":"לְ/נִדָּ֣ה","source":"hebrew","morph":"HR/Ncfsa"},{"reference":"Ezek 7 20","book":"Ezek","chapter":7,"verse":20,"englishText":"","sourceWord":"לְ/נִדָּֽה","source":"hebrew","morph":"HR/Ncfsa"},{"reference":"Ezek 18 6","book":"Ezek","chapter":18,"verse":6,"englishText":"","sourceWord":"נִדָּ֖ה","source":"hebrew","morph":"HNcfsa"},{"reference":"Ezek 22 10","book":"Ezek","chapter":22,"verse":10,"englishText":"","sourceWord":"הַ/נִּדָּ֖ה","source":"hebrew","morph":"HTd/Ncfsa"},{"reference":"Ezek 36 17","book":"Ezek","chapter":36,"verse":17,"englishText":"","sourceWord":"הַ/נִּדָּ֔ה","source":"hebrew","morph":"HTd/Ncfsa"},{"reference":"Ezra 9 11","book":"Ezra","chapter":9,"verse":11,"englishText":"","sourceWord":"נִדָּה֙","source":"hebrew","morph":"HNcfsa"},{"reference":"Ezra 9 11","book":"Ezra","chapter":9,"verse":11,"englishText":"","sourceWord":"בְּ/נִדַּ֖ת","source":"hebrew","morph":"HR/Ncfsc"},{"reference":"Lam 1 17","book":"Lam","chapter":1,"verse":17,"englishText":"","sourceWord":"לְ/נִדָּ֖ה","source":"hebrew","morph":"HR/Ncfsa"},{"reference":"Lev 12 2","book":"Lev","chapter":12,"verse":2,"englishText":""