ral without עיר etc. Num 13:19 ; 2Kin 8:12 ; Jer 48:18 ; Isa 17:3 ; 25:12 ( ׳מ חומתיך משׁגב ) 34:13 (|| ארמנת ), Lam 2:2 , 5 (|| id. ) Psa 89:41 ; Hosea 10:14 ; Amos 5:9 ; Micah 5:10 ; Nahum 3:12 , 14 ; Hab 1:10 ; Dan 11:24 , 39 ; followed by proper name ׳מ צֹד 2Sam 24:7 (compare Josh 19:29 מ ׳עיר צֹר ). בַּקְבֻּק בַּקְבּוק, see below בקק .","rootNote":"also (in plural) feminine (Daniel 11:l5) מִבְצָרָה ; from 1219 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Sam 6 18","keyReferences":["1Sam 6 18","2Chr 17 19","2Kgs 3 19","2Kgs 8 12","2Kgs 10 2","2Kgs 17 9","2Kgs 18 8","2Sam 24 7"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":37,"occurrences":[{"reference":"1Sam 6 18","book":"1Sam","chapter":6,"verse":18,"englishText":"","sourceWord":"מִבְצָ֔ר","source":"hebrew","morph":"HNcmsa"},{"reference":"2Chr 17 19","book":"2Chr","chapter":17,"verse":19,"englishText":"","sourceWord":"הַ/מִּבְצָ֖ר","source":"hebrew","morph":"HTd/Ncmsa"},{"reference":"2Kgs 3 19","book":"2Kgs","chapter":3,"verse":19,"englishText":"","sourceWord":"מִבְצָר֙","source":"hebrew","morph":"HNcmsa"},{"reference":"2Kgs 8 12","book":"2Kgs","chapter":8,"verse":12,"englishText":"","sourceWord":"מִבְצְרֵי/הֶ֞ם","source":"hebrew","morph":"HNcmpc/Sp3mp"},{"reference":"2Kgs 10 2","book":"2Kgs","chapter":10,"verse":2,"englishText":"","sourceWord":"מִבְצָ֖ר","source":"hebrew","morph":"HNcmsa"},{"reference":"2Kgs 17 9","book":"2Kgs","chapter":17,"verse":9,"englishText":"","sourceWord":"מִבְצָֽר","source":"hebrew","morph":"HNcmsa"},{"reference":"2Kgs 18 8","book":"2Kgs","chapter":18,"verse":8,"englishText":"","sourceWord":"מִבְצָֽר","source":"hebrew","morph":"HNcmsa"},{"reference":"2Sam 24 7","book":"2Sam","chapter":24,"verse":7,"englishText":"","sourceWord":"מִבְצַר","source":"hebrew","morph":"HNcmsc"},{"reference":"Amos 5 9","book":"Amos","chapter":5,"verse":9,"englishText":"","sourceWord":"מִבְצָ֥ר","source":"hebrew","mor