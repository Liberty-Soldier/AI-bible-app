ields a lame sense: either add וָלַיְלָה ( ᵐ5 Del Gr Ch), or read יֹם יֹם יוֺם) (יוֺם Lag Nov.Psalt.Gr.Ed.Spec.13 Now. I. יון (√ of following; meaning unknown).","rootNote":"from 3117 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Chr 9 33","keyReferences":["1Chr 9 33","1Kgs 8 59","1Sam 25 16","2Chr 6 20","2Sam 21 10","Deut 1 33","Deut 28 66","Exod 13 21"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":51,"occurrences":[{"reference":"1Chr 9 33","book":"1Chr","chapter":9,"verse":33,"englishText":"","sourceWord":"יוֹמָ֥ם","source":"hebrew","morph":"HD"},{"reference":"1Kgs 8 59","book":"1Kgs","chapter":8,"verse":59,"englishText":"","sourceWord":"יוֹמָ֣ם","source":"hebrew","morph":"HD"},{"reference":"1Sam 25 16","book":"1Sam","chapter":25,"verse":16,"englishText":"","sourceWord":"יוֹמָ֑ם","source":"hebrew","morph":"HD"},{"reference":"2Chr 6 20","book":"2Chr","chapter":6,"verse":20,"englishText":"","sourceWord":"יוֹמָ֣ם","source":"hebrew","morph":"HD"},{"reference":"2Sam 21 10","book":"2Sam","chapter":21,"verse":10,"englishText":"","sourceWord":"יוֹמָ֔ם","source":"hebrew","morph":"HD"},{"reference":"Deut 1 33","book":"Deut","chapter":1,"verse":33,"englishText":"","sourceWord":"יוֹמָֽם","source":"hebrew","morph":"HD"},{"reference":"Deut 28 66","book":"Deut","chapter":28,"verse":66,"englishText":"","sourceWord":"וְ/יוֹמָ֔ם","source":"hebrew","morph":"HC/D"},{"reference":"Exod 13 21","book":"Exod","chapter":13,"verse":21,"englishText":"","sourceWord":"יוֹמָ֜ם","source":"hebrew","morph":"HD"},{"reference":"Exod 13 21","book":"Exod","chapter":13,"verse":21,"englishText":"","sourceWord":"יוֹמָ֥ם","source":"hebrew","morph":"HD"},{"reference":"Exod 13 22","book":"Exod","chapter":13,"verse":22,"englishText":"","sourceWord":"יוֹמָ֔ם","source":"hebrew","morph":"HD"},{"reference":"Exod 40 38","book":"Exod","chapter":40,"verse":38,"englishText":"","sourceWord":"יוֹמָ֔ם","source":"hebrew","morph"