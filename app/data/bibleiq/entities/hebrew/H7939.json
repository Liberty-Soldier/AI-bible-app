ssage-money, fare , Jonah 1:3 . מִי שִׁכְּ adjective, of a people of שֶׁכֶם , with article as collective noun ׳הַשּׁ Num 26:31 .","rootNote":"from 7936 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Kgs 5 20","keyReferences":["1Kgs 5 20","2Chr 15 7","Deut 15 18","Deut 24 15","Eccl 4 9","Eccl 9 5","Exod 2 9","Exod 22 14"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":28,"occurrences":[{"reference":"1Kgs 5 20","book":"1Kgs","chapter":5,"verse":20,"englishText":"","sourceWord":"וּ/שְׂכַ֤ר","source":"hebrew","morph":"HC/Ncmsc"},{"reference":"2Chr 15 7","book":"2Chr","chapter":15,"verse":7,"englishText":"","sourceWord":"שָׂכָ֖ר","source":"hebrew","morph":"HNcmsa"},{"reference":"Deut 15 18","book":"Deut","chapter":15,"verse":18,"englishText":"","sourceWord":"שְׂכַ֣ר","source":"hebrew","morph":"HNcmsc"},{"reference":"Deut 24 15","book":"Deut","chapter":24,"verse":15,"englishText":"","sourceWord":"שְׂכָר֜/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"Eccl 4 9","book":"Eccl","chapter":4,"verse":9,"englishText":"","sourceWord":"שָׂכָ֥ר","source":"hebrew","morph":"HNcmsa"},{"reference":"Eccl 9 5","book":"Eccl","chapter":9,"verse":5,"englishText":"","sourceWord":"שָׂכָ֔ר","source":"hebrew","morph":"HNcmsa"},{"reference":"Exod 2 9","book":"Exod","chapter":2,"verse":9,"englishText":"","sourceWord":"שְׂכָרֵ֑/ךְ","source":"hebrew","morph":"HNcmsc/Sp2fs"},{"reference":"Exod 22 14","book":"Exod","chapter":22,"verse":14,"englishText":"","sourceWord":"בִּ/שְׂכָרֽ/וֹ","source":"hebrew","morph":"HR/Ncmsc/Sp3ms"},{"reference":"Ezek 29 18","book":"Ezek","chapter":29,"verse":18,"englishText":"","sourceWord":"וְ֠/שָׂכָר","source":"hebrew","morph":"HC/Ncmsa"},{"reference":"Ezek 29 19","book":"Ezek","chapter":29,"verse":19,"englishText":"","sourceWord":"שָׂכָ֖ר","source":"hebrew","morph":"HNcmsa"},{"reference":"Gen 15 1","book":"Gen","chapter":15,"verse":1,"englishText":"","sourceWord":"שְׂכָ