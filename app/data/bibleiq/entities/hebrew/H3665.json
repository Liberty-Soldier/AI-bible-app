ed 1Sam 7:13 ; 1Chr 20:4 ; 2Chr 13:18 ; followed by לִפְנֵי person Judg 8:28 ; מִמְּנֵי 11:33 ; under some one תַּחַת 3:30 ; Psa 106:42 . Hiph`il Perfect 3masculine singular הִכְנִיעַ 2Chr 28:19 ; 1 singular הִכְנַעְתִּי 1Chr 17:10 ; Imperfect 3masculine singular וַיַּכְנַע Judg 4:23 ; Psa 107:12 ; suffix יַכְנִיעֵם Deut 9:3 2 t.; 2 masculine singular תַּכְנִיעַ Isa 25:5 ; וַתַּכְנַע Neh 9:24 ; 1 singular אַכְנִיעַ Psa 81:15 ; Imperative הַכְנִיעֵהוּ Job 40:12 ; &#8212; 1 humble 2Chr 28:19 ; Job 40:12 ; Psa 107:12 (object לֵב ), Isa 25:5 (object זָרִים שְׁאוֺן ). 2 subdue enemies 2Sam 8:1 = 1Chr 18:1 ; 17:10 ; Psa 81:15 ; followed by לִפְנֵי Deut 9:3 ; Judg 4:23 ; Neh 9:24 .","rootNote":"a primitive root;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Chr 17 10","keyReferences":["1Chr 17 10","1Chr 18 1","1Chr 20 4","1Kgs 21 29","1Kgs 21 29","1Sam 7 13","2Chr 7 14","2Chr 12 6"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":36,"occurrences":[{"reference":"1Chr 17 10","book":"1Chr","chapter":17,"verse":10,"englishText":"","sourceWord":"וְ/הִכְנַ֖עְתִּי","source":"hebrew","morph":"HC/Vhq1cs"},{"reference":"1Chr 18 1","book":"1Chr","chapter":18,"verse":1,"englishText":"","sourceWord":"וַ/יַּכְנִיעֵ֑/ם","source":"hebrew","morph":"HC/Vhw3ms/Sp3mp"},{"reference":"1Chr 20 4","book":"1Chr","chapter":20,"verse":4,"englishText":"","sourceWord":"וַ/יִּכָּנֵֽעוּ","source":"hebrew","morph":"HC/VNw3mp"},{"reference":"1Kgs 21 29","book":"1Kgs","chapter":21,"verse":29,"englishText":"","sourceWord":"נִכְנַ֥ע","source":"hebrew","morph":"HVNp3ms"},{"reference":"1Kgs 21 29","book":"1Kgs","chapter":21,"verse":29,"englishText":"","sourceWord":"נִכְנַ֣ע","source":"hebrew","morph":"HVNp3ms"},{"reference":"1Sam 7 13","book":"1Sam","chapter":7,"verse":13,"englishText":"","sourceWord":"וַ/יִּכָּֽנְעוּ֙","source":"hebrew","morph":"HC/VNw3mp"},{"reference":"2Chr 7 14","book":"2Chr","chapter":7,"verse":14,"engl