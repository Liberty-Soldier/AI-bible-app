יחֶ֑ךָ Psa 84:10 . 3 Cyrus as commissioned by מְשִׁיחוֺ ׳י, Isa 45:1 . 4 Messianic prince , נָגִיד עַדמָֿשִׁיחַ Dan 9:25 = מָשִׁיחַ 9:26 (see Br MP 422 f. ; others distinguished ׳מ 9:25 from 9:26 and refer 9:25 to Cyrus [as 3 ; so Ew see Leng Schü Co Behrm], or high priest Joshua [as 2 ; so Gr Bev], Dan 9:26 to Seleucus IV [Ew see Leng], or high priest Onias III. [Hi Gr Co Bev Behrm]). 5 patriarchs, regarded as anointed kings Psa 105:15 = 1Chr 16:22 .","rootNote":"from 4886 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"1Chr 16 22","keyReferences":["1Chr 16 22","1Sam 2 10","1Sam 2 35","1Sam 12 3","1Sam 12 5","1Sam 16 6","1Sam 24 7","1Sam 24 7"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":39,"occurrences":[{"reference":"1Chr 16 22","book":"1Chr","chapter":16,"verse":22,"englishText":"","sourceWord":"בִּ/מְשִׁיחָ֔/י","source":"hebrew","morph":"HR/Aampc/Sp1cs"},{"reference":"1Sam 2 10","book":"1Sam","chapter":2,"verse":10,"englishText":"","sourceWord":"מְשִׁיחֽ/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"1Sam 2 35","book":"1Sam","chapter":2,"verse":35,"englishText":"","sourceWord":"מְשִׁיחִ֖/י","source":"hebrew","morph":"HNcmsc/Sp1cs"},{"reference":"1Sam 12 3","book":"1Sam","chapter":12,"verse":3,"englishText":"","sourceWord":"מְשִׁיח֗/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"1Sam 12 5","book":"1Sam","chapter":12,"verse":5,"englishText":"","sourceWord":"מְשִׁיח/וֹ֙","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"1Sam 16 6","book":"1Sam","chapter":16,"verse":6,"englishText":"","sourceWord":"מְשִׁיחֽ/וֹ","source":"hebrew","morph":"HNcmsc/Sp3ms"},{"reference":"1Sam 24 7","book":"1Sam","chapter":24,"verse":7,"englishText":"","sourceWord":"לִ/מְשִׁ֣יחַ","source":"hebrew","morph":"HR/Ncmsc"},{"reference":"1Sam 24 7","book":"1Sam","chapter":24,"verse":7,"englishText":"","sourceWord":"מְשִׁ֥יחַ","source":"hebrew","morph":"HNcmsc"},{"reference":"1