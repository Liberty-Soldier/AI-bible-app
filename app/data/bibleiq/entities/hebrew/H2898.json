fer Hosea 10:11 ; of people of ׳י Zech 9:17 ; of ׳י himself Exod 33:19 (JE). b. לב(בׅ טוּב joy of heart Deut 28:47 ; Isa 65:14 (see I. טוֺב 2 , II. ׳ט 7 ). c. prosperity Job 20:21 ; 21:16 ; of Jerusalem Psa 128:5 ; צַדִּיקִים בְּטוּב Prov 11:10 in the prosperity of the righteous the city rejoiceth. d. goodness of taste, discernment Psa 119:66 . 4 abstract, goodness of God: a. in bestowing good things Neh 9:25 . b. in the salvation of his people Isa 63:7 ; Psa 25:7 ; 145:7 . c. stored up for his saints Psalm Psa 31:20 .","rootNote":"from 2895 ;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Kgs 8 9","keyReferences":["2Kgs 8 9","Deut 6 11","Deut 28 47","Exod 33 19","Ezra 9 12","Gen 24 10","Gen 45 18","Gen 45 20"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":32,"occurrences":[{"reference":"2Kgs 8 9","book":"2Kgs","chapter":8,"verse":9,"englishText":"","sourceWord":"ט֣וּב","source":"hebrew","morph":"HNcmsc"},{"reference":"Deut 6 11","book":"Deut","chapter":6,"verse":11,"englishText":"","sourceWord":"טוּב֮","source":"hebrew","morph":"HNcmsa"},{"reference":"Deut 28 47","book":"Deut","chapter":28,"verse":47,"englishText":"","sourceWord":"וּ/בְ/ט֣וּב","source":"hebrew","morph":"HC/R/Ncmsc"},{"reference":"Exod 33 19","book":"Exod","chapter":33,"verse":19,"englishText":"","sourceWord":"טוּבִ/י֙","source":"hebrew","morph":"HNcmsc/Sp1cs"},{"reference":"Ezra 9 12","book":"Ezra","chapter":9,"verse":12,"englishText":"","sourceWord":"ט֣וּב","source":"hebrew","morph":"HNcmsc"},{"reference":"Gen 24 10","book":"Gen","chapter":24,"verse":10,"englishText":"","sourceWord":"ט֥וּב","source":"hebrew","morph":"HNcmsc"},{"reference":"Gen 45 18","book":"Gen","chapter":45,"verse":18,"englishText":"","sourceWord":"טוּב֙","source":"hebrew","morph":"HNcmsc"},{"reference":"Gen 45 20","book":"Gen","chapter":45,"verse":20,"englishText":"","sourceWord":"ט֛וּב","source":"hebrew","morph":"HNcmsc"},{"reference":"Gen