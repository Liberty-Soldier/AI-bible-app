e away (from hunger) Lam 4:9 . 4 flow , of issue from woman (all P), Lev 15:25 דָּמָהּ זוֺב יָזוּב (see ווֺב ); especially have an issue ( flux, gleet ), of woman 15:25 ; and 15:19 ( זָבָה תִּהְיֶה ); usually of man, 2Sam 3:29 (|| מְצֹרָע ); elsewhere P, Lev 15:2 מִבִּשָׂרוֺ זָב ; with cognate accusative 15:33 ; ordinarily Participle זָב one that has an issue 15:4 , 6 , 7 , 8 , 9 , 11 , 12 , 13 , 32 (all P), 22:4 (H; || צָרוּעַ ); also Num 5:2 (P; || id. )","rootNote":"a primitive root;","sources":["MorphHB occurrences","Strong Hebrew Dictionary","Brown-Driver-Briggs"]},"firstMention":"2Sam 3 29","keyReferences":["2Sam 3 29","Deut 6 3","Deut 11 9","Deut 26 9","Deut 26 15","Deut 27 3","Deut 31 20","Exod 3 8"],"related":{"people":[],"places":[],"concepts":[],"events":[]},"occurrenceCount":42,"occurrences":[{"reference":"2Sam 3 29","book":"2Sam","chapter":3,"verse":29,"englishText":"","sourceWord":"זָ֠ב","source":"hebrew","morph":"HVqrmsa"},{"reference":"Deut 6 3","book":"Deut","chapter":6,"verse":3,"englishText":"","sourceWord":"זָבַ֥ת","source":"hebrew","morph":"HVqrfsc"},{"reference":"Deut 11 9","book":"Deut","chapter":11,"verse":9,"englishText":"","sourceWord":"זָבַ֥ת","source":"hebrew","morph":"HVqrfsc"},{"reference":"Deut 26 9","book":"Deut","chapter":26,"verse":9,"englishText":"","sourceWord":"זָבַ֥ת","source":"hebrew","morph":"HVqrfsc"},{"reference":"Deut 26 15","book":"Deut","chapter":26,"verse":15,"englishText":"","sourceWord":"זָבַ֥ת","source":"hebrew","morph":"HVqrfsc"},{"reference":"Deut 27 3","book":"Deut","chapter":27,"verse":3,"englishText":"","sourceWord":"זָבַ֤ת","source":"hebrew","morph":"HVqrfsc"},{"reference":"Deut 31 20","book":"Deut","chapter":31,"verse":20,"englishText":"","sourceWord":"זָבַ֤ת","source":"hebrew","morph":"HVqrfsc"},{"reference":"Exod 3 8","book":"Exod","chapter":3,"verse":8,"englishText":"","sourceWord":"זָבַ֥ת","source":"hebrew","morph":"HVqrfsc"},{"reference":"Exod 3 17","book":"Exod","chapter":3,"verse":17,"englishText":"","sou