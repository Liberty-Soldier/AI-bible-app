{
  "name": "ai-bible-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:see": "node scripts/see/compiler/build-see.js",
    "prebuild": "node scripts/split-scripture-runtime.js && node scripts/export-bibleiq-canonical-runtime.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:entity": "node scripts/entity/build-entity-graph.js",
    "build:knowledge": "node --max-old-space-size=4096 scripts/entity/build-knowledge-index.js",
    "build:entity-platform": "npm run build:entity && npm run build:knowledge"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.2",
    "next": "16.2.7",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
